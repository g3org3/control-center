#!/usr/bin/env python3
"""List DigitalOcean droplets.

Required env:
  DIGITALOCEAN_TOKEN

Usage:
  do-list-droplets
  do-list-droplets --json
"""
import argparse
import json
import os
import sys
import urllib.parse
import urllib.request
import urllib.error


def get_json(url, token):
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        raise SystemExit(f"DigitalOcean API error HTTP {e.code}: {body}")


def main():
    parser = argparse.ArgumentParser(description="List DigitalOcean droplets")
    parser.add_argument("--json", action="store_true", help="print raw summarized JSON")
    args = parser.parse_args()

    token = os.environ.get("DIGITALOCEAN_TOKEN")
    if not token:
        raise SystemExit("Missing DIGITALOCEAN_TOKEN environment variable")

    droplets = []
    page = 1
    while True:
        url = "https://api.digitalocean.com/v2/droplets?" + urllib.parse.urlencode(
            {"page": page, "per_page": 200}
        )
        data = get_json(url, token)
        droplets.extend(data.get("droplets", []))
        if "next" not in data.get("links", {}).get("pages", {}):
            break
        page += 1

    rows = []
    for d in droplets:
        v4_public = []
        v4_private = []
        v6 = []
        for net in d.get("networks", {}).get("v4", []):
            if net.get("type") == "public":
                v4_public.append(net.get("ip_address"))
            elif net.get("type") == "private":
                v4_private.append(net.get("ip_address"))
        for net in d.get("networks", {}).get("v6", []):
            v6.append(net.get("ip_address"))
        rows.append(
            {
                "id": d.get("id"),
                "name": d.get("name"),
                "status": d.get("status"),
                "region": (d.get("region") or {}).get("slug"),
                "size": (d.get("size") or {}).get("slug"),
                "image": (d.get("image") or {}).get("slug") or (d.get("image") or {}).get("name"),
                "memory_mb": d.get("memory"),
                "vcpus": d.get("vcpus"),
                "disk_gb": d.get("disk"),
                "public_ipv4": ",".join(v4_public) or "-",
                "private_ipv4": ",".join(v4_private) or "-",
                "ipv6": ",".join(v6) or "-",
                "tags": ",".join(d.get("tags") or []) or "-",
                "created_at": d.get("created_at"),
            }
        )

    if args.json:
        print(json.dumps(rows, indent=2))
        return

    print(f"Total droplets: {len(rows)}")
    for r in rows:
        print()
        print(f"{r['name']} ({r['id']})")
        print(f"  status: {r['status']}")
        print(f"  region/size: {r['region']} / {r['size']}")
        print(f"  image: {r['image']}")
        print(f"  cpu/ram/disk: {r['vcpus']} vCPU / {r['memory_mb']} MB / {r['disk_gb']} GB")
        print(f"  public IPv4: {r['public_ipv4']}")
        print(f"  private IPv4: {r['private_ipv4']}")
        print(f"  IPv6: {r['ipv6']}")
        print(f"  tags: {r['tags']}")
        print(f"  created: {r['created_at']}")


if __name__ == "__main__":
    main()
