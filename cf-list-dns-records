#!/usr/bin/env python3
"""List Cloudflare DNS records for a zone.

Required env:
  CLOUDFLARE_TOKEN

Usage:
  cf-list-dns-records jagc.app
  cf-list-dns-records jagc.app --json
"""
import argparse
import json
import os
import sys
import urllib.parse
import urllib.request
import urllib.error


def cf_request(path, token, params=None):
    url = "https://api.cloudflare.com/client/v4" + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        raise SystemExit(f"Cloudflare API error HTTP {e.code}: {body}")
    if not data.get("success"):
        raise SystemExit("Cloudflare API error: " + json.dumps(data.get("errors"), indent=2))
    return data


def zone_id_for_name(token, zone_name):
    data = cf_request("/zones", token, {"name": zone_name})
    zones = data.get("result", [])
    if not zones:
        raise SystemExit(f"No Cloudflare zone found for {zone_name}")
    return zones[0]["id"]


def main():
    parser = argparse.ArgumentParser(description="List Cloudflare DNS records")
    parser.add_argument("zone", help="zone name, e.g. jagc.app")
    parser.add_argument("--json", action="store_true", help="print JSON")
    args = parser.parse_args()

    token = os.environ.get("CLOUDFLARE_TOKEN")
    if not token:
        raise SystemExit("Missing CLOUDFLARE_TOKEN environment variable")

    zone_id = zone_id_for_name(token, args.zone)
    records = []
    page = 1
    while True:
        data = cf_request(
            f"/zones/{zone_id}/dns_records",
            token,
            {"per_page": 100, "page": page, "order": "type", "direction": "asc"},
        )
        records.extend(data.get("result", []))
        info = data.get("result_info") or {}
        if page >= info.get("total_pages", page):
            break
        page += 1

    rows = [
        {
            "id": r.get("id"),
            "type": r.get("type"),
            "name": r.get("name"),
            "content": r.get("content"),
            "ttl": r.get("ttl"),
            "proxied": r.get("proxied"),
            "priority": r.get("priority"),
            "comment": r.get("comment"),
        }
        for r in records
    ]

    if args.json:
        print(json.dumps(rows, indent=2))
        return

    print(f"Zone: {args.zone}")
    print(f"Total DNS records: {len(rows)}")
    for r in rows:
        ttl = "auto" if r["ttl"] == 1 else r["ttl"]
        proxied = "yes" if r["proxied"] else "no" if r["proxied"] is not None else "-"
        priority = f" priority={r['priority']}" if r["priority"] is not None else ""
        comment = f" comment={r['comment']}" if r["comment"] else ""
        print(f"{r['type']:5} {r['name']:<35} {r['content']} ttl={ttl} proxied={proxied}{priority}{comment}")


if __name__ == "__main__":
    main()
